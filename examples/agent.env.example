# forwarder agent — guest-side env. Copy to `.env` next to tunnel.sh and fill in.
# NEVER commit a filled-in copy: FORWARDER_AGENT_TOKEN is the shared secret.

# The lab box's control endpoint. A bare host expands to
# wss://<host>/__forwarder/v1/control. Must resolve to the box (it's covered by
# the *.lab.madekivi.fi A-record).
FORWARDER_SERVER=tunnel.lab.madekivi.fi

# Shared secret. Read it off the box: grep FORWARDER_AGENT_TOKEN
# /etc/lab-control/lab-control.env  (setup.sh generated it).
FORWARDER_AGENT_TOKEN=

# Tunnels: id:http:hostname:localport, comma-separated for several.
# The hostname is the public *.lab.madekivi.fi subdomain; localport is where your
# app listens on 127.0.0.1.
FORWARDER_TUNNELS=web:http:ios.lab.madekivi.fi:8080

# --- reminder: app-side settings (e.g. iOS-pwa-runner's OWN .env) ----------
# Passkeys bind to the public origin, so set these in the APP, not here:
#   RPID=ios.lab.madekivi.fi
#   ORIGIN=https://ios.lab.madekivi.fi
#   AUTH_SECURE_COOKIES=true

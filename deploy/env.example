# Template for /etc/forwarder/forwarder.env (root-owned, 0600).
# install.sh creates that file and generates the token on first run; it never
# overwrites values that are already set. NO SECRETS IN THE REPO.
#
# Non-secret keys can instead be pinned in deploy/site.env, which is tracked in
# git, sourced after this file, and wins for the keys it sets — reconfigure with
# a commit instead of a shell. Keep only secrets and box-local values here.

# Shared bearer secret agents authenticate with. Required.
# Generated by install.sh if absent: openssl rand -hex 32
FORWARDER_AGENT_TOKEN=

# FQDN the agents dial. Always cert-approved by /ask, so it must be set before
# any agent can connect -- an agent needs a valid cert on this host to dial in.
FORWARDER_CONTROL_HOST=tunnel.example.com

# Loopback ports Caddy proxies to. Defaults shown; rarely need changing.
FORWARDER_HTTP_PORT=7080
FORWARDER_MGMT_PORT=7001

# Raw TCP tunnels: unset = off. When set, install.sh opens exactly this range in
# nftables and drops in a systemd override that lets the process bind publicly.
#FORWARDER_TCP_PORT_RANGE=10000-19999

# Pretty host shown in a TCP tunnel's assigned address.
#FORWARDER_PUBLIC_HOST=tunnel.example.com


# ---------------------------------------------------------------- site tunnel
# Optional. Set SITE_PEER_IP to put HAProxy in front of Caddy on :80/:443 and
# pass the site hostnames through to a fixed peer over WireGuard, TLS
# unterminated. Leave unset and Caddy keeps both ports as usual.
#
# Needed because some backends cannot tolerate TLS termination -- a Kubernetes
# API server authenticating callers by client certificate is the motivating case.
#SITE_PEER_IP=10.66.0.2
#SITE_HOSTS="example.com k8s.example.com"    # exact SNI/Host matches; QUOTE it — install.sh sources this file
#SITE_SUFFIX=.example.com                    # suffix match, for wildcard subdomains
#K8S_HOST=k8s.example.com                    # documentation only, used in haproxy.cfg comments
#CADDY_HTTP_PORT=8080
#CADDY_HTTPS_PORT=8443


# ------------------------------------------------------------------ UDP relay
# Optional. Forward a public UDP port range to one NAT'd peer over the same
# WireGuard interface. For apps Caddy cannot front because they are not TCP:
# QUIC/WebTransport media is the motivating case.
#
# Public :N becomes peer :N (the port is never translated), the source is
# rewritten to WG_EDGE_ADDR so replies come back through conntrack, and nftables
# forwards nothing outside this range to anything but this peer. Setting it also
# turns on net.ipv4.ip_forward, which no other feature here needs.
#
# Keep the range as tight as the app allows, and remember the relay adds no auth
# of its own — whatever answers on those ports is as reachable as if it were
# on the public internet directly.
#UDP_RELAY_PEER_IP=10.66.0.3
#UDP_RELAY_PEER_PUBKEY=                      # the relay peer's wg pubkey
#UDP_RELAY_PORT_RANGE=54080-54130


# ------------------------------------------------- WireGuard (both of the above)
# Shared by the site tunnel and the UDP relay; needed if either is set.
#WG_PORT=51820
#WG_EDGE_ADDR=10.66.0.1
#WG_EDGE_PRIVKEY=                            # wg genkey
